{
  "name": "@maestro/cli",
  "version": "0.1.0",
  "description": "AI agent orchestrator for software development. Create sessions, launch specialized agents, and monitor their progress on your codebase.",
  "keywords": ["ai", "agent", "orchestrator", "llm", "development", "automation", "cli", "tui"],
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/maestro",
    "directory": "packages/maestro-cli"
  },
  "bin": { "maestro": "./index.js" },
  "main": "./index.js",
  "files": [
    "index.js",
    "cli.ts",
    "api-client.ts",
    "config.ts",
    "output-formatter.ts",
    "json-parser.ts",
    "sandbox-manager.ts",
    "adapt-optimize.ts",
    "shell.ts",
    "discover.ts",
    "init-wizard.ts",
    "esm-bridge.mjs",
    "utils/",
    "dist/",
    "content/"
  ],
  "engines": { "node": ">=18.0.0" },
  "bundleDependencies": [
    "@maestro/tui",
    "@maestro/monitor",
    "@maestro/code",
    "@maestro/client",
    "@maestro/sidecar",
    "tree-kill",
    "tsx",
    "ink",
    "react"
  ],
  "dependencies": {
    "@maestro/tui": "*",
    "@maestro/monitor": "*",
    "@maestro/code": "*",
    "@maestro/client": "*",
    "@maestro/sidecar": "*",
    "tsx": "^4.21.0",
    "minimist": "^1.2.8",
    "ink": "^6.7.0",
    "react": "^19.2.4"
  },
  "scripts": {
    "build:dist": "node ../../scripts/build-dist.js",
    "prepublishOnly": "npm run build:dist",
    "test:ink": "vitest run tests/interactive/",
    "test:all": "npm test && npm run test:ink"
  }
}

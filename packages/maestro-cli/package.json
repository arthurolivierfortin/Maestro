{
  "name": "@maestro/cli",
  "version": "0.1.0",
  "description": "Maestro CLI — orchestrate AI agents, train blocks, monitor sessions.",
  "bin": { "maestro": "./index.js" },
  "main": "./index.js",
  "files": [

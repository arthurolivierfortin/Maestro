    "@maestro/monitor": "*",
    "@maestro/code": "*",
    "@maestro/client": "*",
    "@maestro/sidecar": "*",
    "tsx": "^4.21.0",
    "minimist": "^1.2.8",
    "ink": "^6.7.0",
    "react": "^19.2.4"
  },
  "scripts": {
    "build:dist": "node ../../scripts/build-dist.js",

{
  "name": "@maestro/client",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Maestro API — sessions, blocks, variables, workspaces, LLM provider, and real-time events.",
  "type": "module",
  "files": ["index.ts", "src/"],
  "exports": {
    ".": "./index.ts",
    "./types": "./src/types.ts",
    "./errors": "./src/errors.ts",
    "./realtime": "./src/realtime/signalr-client.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "npx vitest run tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@microsoft/signalr": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@microsoft/signalr": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "createElement",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "hooks/**/*.ts",
    "components/**/*.ts",
    "theme/**/*.ts",
    "keybindings/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts",
    "app/**/*.ts",
    "index.ts"
  ],
  "exclude": ["node_modules"]
}

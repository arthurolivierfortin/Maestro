{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "createElement",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@maestro/tui": ["../tui/index.ts"],
      "@maestro/tui/*": ["../tui/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "tests"]
}

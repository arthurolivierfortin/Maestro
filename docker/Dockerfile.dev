FROM node:22-alpine

# ── System packages ──
RUN apk add --no-cache \
    python3 py3-pip py3-setuptools python3-dev \
    git bash curl jq gosu build-base \
    && ln -sf /usr/bin/python3 /usr/bin/python

# ── .NET SDK (for building and testing C# code) ──
RUN apk add --no-cache dotnet9-sdk || \
    (wget https://dot.net/v1/dotnet-install.sh -O /tmp/dotnet-install.sh && \
     chmod +x /tmp/dotnet-install.sh && \
     /tmp/dotnet-install.sh --channel 10.0 --install-dir /usr/share/dotnet && \
     ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet)

# ── GitHub CLI ──
RUN apk add --no-cache github-cli

# ── Claude Code ──
RUN npm install -g @anthropic-ai/claude-code

# ── Auth dependencies (PyJWT + cryptography for gh_app_auth.py) ──
RUN pip install --no-cache-dir --break-system-packages PyJWT cryptography

# ── Setup node user (already exists in node:22-alpine with uid 1000) ──
RUN mkdir -p /home/node/.claude \
    && echo '{"hasCompletedOnboarding":true}' > /home/node/.claude.json \
    && chown node:node /home/node/.claude.json /home/node/.claude

# ── Windows path compatibility ──
RUN mkdir -p /c && ln -s /app /c/Meastro

# ── Project setup ──
WORKDIR /app
COPY . .

# ── Docker-specific configs ──
COPY docker/.mcp.json.docker /app/.mcp.json.docker
COPY docker/settings.json /app/.claude/settings.json.docker
COPY docker/entrypoint.dev.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && chown -R node:node /app/.claude /app/docker /app/scripts /app/docs /c/Meastro

# ── Environment ──
ENV DISABLE_AUTOUPDATER=1
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
ENV NODE_OPTIONS=--max-old-space-size=4096
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1

ENTRYPOINT ["/entrypoint.sh"]

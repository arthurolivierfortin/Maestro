    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5000"
      }
    }
  },
  "Maestro": {
    "Paths": {
      "RepoRoot": "C:\\Meastro",
      "GlobalBlocks": "C:\\Meastro\\content\\system\\blocks",
      "AdditionalProjects": [
        "C:\\Cantante"
      ]
    }
  },
  "Security": {

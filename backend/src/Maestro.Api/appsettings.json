{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Maestro": {
    "Paths": {
      "RepoRoot": "C:\\Meastro",
      "GlobalBlocks": "C:\\Meastro\\content\\system\\blocks",
      "AdditionalProjects": [
        "C:\\Cantante"
      ]
    }
  },
  "Security": {
    "Enabled": true,
    "AllowRemote": false
  },
  "LLMProvider": {
    "BaseUrl": "http://localhost:8000",
    "DefaultModel": "deepseek-ai/deepseek-coder-1.3b-instruct",
    "TimeoutSeconds": 300,
    "MaxRetries": 3,
    "InitialRetryDelayMs": 200,
    "MaxNewTokens": 512,
    "Temperature": 0.7,
    "DoSample": true,
    "TopP": 0.95,
    "SystemPrompt": null
  }
}

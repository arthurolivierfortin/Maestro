{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow Nodes",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "type", "position"],
    "properties": {
      "id": { "type": "string" },
      "type": { "type": "string" },
      "label": { "type": "string" },
      "position": {
        "type": "object",
        "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
        "required": ["x", "y"]
      },
      "config": { "type": ["object", "null"] }
    }
  }
}

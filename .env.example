# Maestro Development Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit tokens or API keys.
# dev-start.ps1 loads this file and passes vars to all services.

# =============================================================================
# LLM Providers
# =============================================================================

# Anthropic API (direct — https://console.anthropic.com/settings/keys)
# PROVIDERS__ANTHROPIC__APIKEY=sk-ant-xxx

# GitHub Models (free tier — PAT with no scopes: github.com/settings/tokens)
# PROVIDERS__GITHUBMODELS__TOKEN=ghp_xxx

# Azure AI Inference (if using Azure deployments)
# PROVIDERS__AZUREINFERENCE__APIKEY=xxx

# =============================================================================
# Autonomous Dev Pipeline (Phase 65 — Docker containers)
# =============================================================================

# GitHub App for autonomous commits/PRs
# Create: Settings → Developer settings → GitHub Apps
# Permissions: Contents (write), Issues (write), Pull requests (write), Metadata (read)
# Install on your repo, then fill in:
# GH_APP_ID=
# GH_APP_INSTALLATION_ID=
# GH_APP_PEM_PATH=~/.github-apps/maestro-dev.private-key.pem

# GitHub repo (owner/repo format)
# GH_REPO=

# Logging level for containers
# LOG_LEVEL=Information

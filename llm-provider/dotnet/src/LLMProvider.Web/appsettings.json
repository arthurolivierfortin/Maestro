{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "LLMProvider": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/llm-provider-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",

  "KeyVault": {
    "Url": ""
  },

  "Server": {
    "BindAddress": "127.0.0.1",
    "Port": 5010
  },

  "Security": {
    "ApiKey": {
      "Enabled": true,
      "Key": ""
    }
  },

  "Monitor": {
    "AutoStart": true,
    "BackendUrl": "http://localhost:5010"
  },

  "Statistics": {
    "PersistenceEnabled": true,
    "PersistenceIntervalSeconds": 60,
    "DataDirectory": "data/statistics",
    "MaxRecentRequests": 10000
  },

  "Queue": {
    "Enabled": true,
    "MaxWaitTimeSeconds": 30,
    "ProcessorPollIntervalMs": 100,
    "SwitchCostThreshold": 0.5,
    "DefaultSwitchCostMs": 15000
  },

  "Providers": {
    "Priority": {
      "ModelPreferences": {
        "claude-sonnet-4-6": "ClaudeCode",
        "claude-opus-4-6": "ClaudeCode",
        "claude-haiku-4-5-20251001": "ClaudeCode"
      }
    },
    "Azure": {
      "Endpoint": "",
      "ApiKey": "",
      "UseDefaultCredential": false,
      "TimeoutSeconds": 120,
      "MaxRetries": 3,
      "Deployments": []
    },
    "AzureInference": {
      "Endpoint": "",
      "ApiKey": "",
      "UseDefaultCredential": false,
      "TimeoutSeconds": 120,
      "MaxRetries": 3,
      "Models": []
    },
    "Local": {
      "BaseUrl": "http://localhost:8000",
      "TimeoutSeconds": 300,
      "MaxRetries": 3,
      "DefaultModel": "deepseek-ai/deepseek-coder-1.3b-instruct",
      "AutoStart": true,
      "PythonPath": "python",
      "ProjectPath": "",
      "Port": 8000,
      "PreloadModel": true,
      "Use8BitQuantization": false
    },
    "ClaudeCode": {
      "CliPath": "claude",
      "DefaultModel": "sonnet",
      "TimeoutSeconds": 120,
      "MaxTurns": 1,
      "Models": [
        { "ModelId": "claude-sonnet-4-6", "Alias": "sonnet", "ContextLength": 200000, "Capabilities": ["chat", "code", "reasoning"], "ParametersBillions": 70 },
        { "ModelId": "claude-opus-4-6", "Alias": "opus", "ContextLength": 200000, "Capabilities": ["chat", "code", "reasoning"], "ParametersBillions": 200 },
        { "ModelId": "claude-haiku-4-5-20251001", "Alias": "haiku", "ContextLength": 200000, "Capabilities": ["chat", "code"], "ParametersBillions": 20 }
      ]
    },
    "Anthropic": {
      "ApiKey": "",
      "BaseUrl": "https://api.anthropic.com",
      "TimeoutSeconds": 120,
      "MaxRetries": 3,
      "Models": [
        { "ModelId": "claude-sonnet-4-6", "ContextLength": 200000, "MaxOutputTokens": 16384, "InputTokenPrice": 3.0, "OutputTokenPrice": 15.0, "Capabilities": ["chat", "code", "reasoning"], "ParametersBillions": 70 },
        { "ModelId": "claude-haiku-4-5-20251001", "ContextLength": 200000, "MaxOutputTokens": 16384, "InputTokenPrice": 0.80, "OutputTokenPrice": 4.0, "Capabilities": ["chat", "code"], "ParametersBillions": 20 },
        { "ModelId": "claude-opus-4-6", "ContextLength": 200000, "MaxOutputTokens": 16384, "InputTokenPrice": 15.0, "OutputTokenPrice": 75.0, "Capabilities": ["chat", "code", "reasoning"], "ParametersBillions": 200 }
      ]
    },
    "GitHubModels": {
      "Endpoint": "https://models.inference.ai.azure.com",
      "Token": "",
      "TimeoutSeconds": 120,
      "MaxRetries": 3,
      "Models": [
        { "ModelId": "gpt-4o", "ContextLength": 128000, "MaxOutputTokens": 16384, "InputTokenPrice": 2.5, "OutputTokenPrice": 10.0, "Capabilities": ["chat", "function_calling", "structured-output"], "ModelFamily": "gpt", "ParametersBillions": null },
        { "ModelId": "Meta-Llama-3.1-405B-Instruct", "ContextLength": 131072, "MaxOutputTokens": 4096, "InputTokenPrice": 5.33, "OutputTokenPrice": 16.0, "Capabilities": ["chat"], "ModelFamily": "llama", "ParametersBillions": 405 },
        { "ModelId": "Meta-Llama-3.1-70B-Instruct", "ContextLength": 131072, "MaxOutputTokens": 4096, "InputTokenPrice": 0.71, "OutputTokenPrice": 0.71, "Capabilities": ["chat"], "ModelFamily": "llama", "ParametersBillions": 70 },
        { "ModelId": "Meta-Llama-3.1-8B-Instruct", "ContextLength": 131072, "MaxOutputTokens": 4096, "InputTokenPrice": 0.18, "OutputTokenPrice": 0.18, "Capabilities": ["chat"], "ModelFamily": "llama", "ParametersBillions": 8 },
        { "ModelId": "Mistral-large-2407", "ContextLength": 131072, "MaxOutputTokens": 4096, "InputTokenPrice": 2.0, "OutputTokenPrice": 6.0, "Capabilities": ["chat"], "ModelFamily": "mistral", "ParametersBillions": 123 }
      ]
    }
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "LLMProvider": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/llm-provider-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",

  "KeyVault": {
    "Url": ""
  },

  "Server": {
    "BindAddress": "127.0.0.1",
    "Port": 5010
  },

  "Security": {
    "ApiKey": {
      "Enabled": true,
      "Key": ""
    }
  },

  "Monitor": {
    "AutoStart": true,
    "BackendUrl": "http://localhost:5010"
  },

  "Statistics": {
    "PersistenceEnabled": true,
    "PersistenceIntervalSeconds": 60,
    "DataDirectory": "data/statistics",
    "MaxRecentRequests": 10000
  },

  "Queue": {
    "Enabled": true,
    "MaxWaitTimeSeconds": 30,
    "ProcessorPollIntervalMs": 100,
    "SwitchCostThreshold": 0.5,
    "DefaultSwitchCostMs": 15000
  },

  "Providers": {
    "Azure": {
      "Endpoint": "https://your-resource.openai.azure.com/",
      "ApiKey": "",
      "UseDefaultCredential": true,
      "DefaultDeployment": "gpt-4",
      "TimeoutSeconds": 120,
      "MaxRetries": 3,
      "Deployments": [
        {
          "DeploymentName": "gpt-4",
          "ModelId": "gpt-4",
          "ContextLength": 8192,
          "MaxOutputTokens": 4096,
          "InputTokenPrice": 0.03,
          "OutputTokenPrice": 0.06,
          "Capabilities": ["chat", "function_calling"]
        },
        {
          "DeploymentName": "gpt-4o",
          "ModelId": "gpt-4o",
          "ContextLength": 128000,
          "MaxOutputTokens": 4096,
          "InputTokenPrice": 0.005,
          "OutputTokenPrice": 0.015,
          "Capabilities": ["chat", "function_calling", "vision"]
        }
      ]
    },
    "AzureInference": {
      "Endpoint": "https://your-resource.services.ai.azure.com",
      "ApiKey": "",
      "UseDefaultCredential": true,
      "DefaultModel": "llama-3-70b",
      "TimeoutSeconds": 120,
      "MaxRetries": 3,
      "Models": [
        {
          "ModelId": "llama-3-70b",
          "DeploymentName": "llama-3-70b-chat",
          "ContextLength": 8192,
          "MaxOutputTokens": 4096,
          "Capabilities": ["chat"],
          "ModelFamily": "llama"
        },
        {
          "ModelId": "mistral-large",
          "DeploymentName": "mistral-large-2407",
          "ContextLength": 32768,
          "MaxOutputTokens": 4096,
          "Capabilities": ["chat", "function_calling"],
          "ModelFamily": "mistral"
        },
        {
          "ModelId": "phi-3-medium",
          "DeploymentName": "phi-3-medium-128k-instruct",
          "ContextLength": 128000,
          "MaxOutputTokens": 4096,
          "Capabilities": ["chat"],
          "ModelFamily": "phi"
        },
        {
          "ModelId": "cohere-command-r-plus",
          "DeploymentName": "cohere-command-r-plus",
          "ContextLength": 128000,
          "MaxOutputTokens": 4096,
          "Capabilities": ["chat", "function_calling"],
          "ModelFamily": "cohere"
        }
      ]
    },
    "Local": {
      "BaseUrl": "http://localhost:8000",
      "TimeoutSeconds": 300,
      "MaxRetries": 3,
      "DefaultModel": "deepseek-ai/deepseek-coder-1.3b-instruct",
      "AutoStart": true,
      "PythonPath": "python",
      "ProjectPath": "",
      "Port": 8000,
      "PreloadModel": true,
      "Use8BitQuantization": false
    },
    "ClaudeCode": {
      "CliPath": "claude",
      "DefaultModel": "sonnet",
      "TimeoutSeconds": 120,
      "MaxTurns": 1,
      "Models": [
        { "ModelId": "claude-sonnet-4-6", "Alias": "claude-sonnet-4-6", "ContextLength": 200000, "Capabilities": ["chat", "code", "reasoning"] },
        { "ModelId": "claude-opus-4-6", "Alias": "claude-opus-4-6", "ContextLength": 200000, "Capabilities": ["chat", "code", "reasoning"] },
        { "ModelId": "claude-haiku-4-5", "Alias": "claude-haiku-4-5-20251001", "ContextLength": 200000, "Capabilities": ["chat", "code"] },
        { "ModelId": "claude-haiku-4-5-20251001", "Alias": "claude-haiku-4-5-20251001", "ContextLength": 200000, "Capabilities": ["chat", "code"] },
        { "ModelId": "claude-sonnet", "Alias": "sonnet", "ContextLength": 200000, "Capabilities": ["chat", "code", "reasoning"] },
        { "ModelId": "claude-opus", "Alias": "opus", "ContextLength": 200000, "Capabilities": ["chat", "code", "reasoning"] },
        { "ModelId": "claude-haiku", "Alias": "haiku", "ContextLength": 200000, "Capabilities": ["chat", "code"] },
        { "ModelId": "sonnet", "Alias": "sonnet", "ContextLength": 200000, "Capabilities": ["chat", "code", "reasoning"] },
        { "ModelId": "opus", "Alias": "opus", "ContextLength": 200000, "Capabilities": ["chat", "code", "reasoning"] },
        { "ModelId": "haiku", "Alias": "haiku", "ContextLength": 200000, "Capabilities": ["chat", "code"] }
      ]
    }
  }
}

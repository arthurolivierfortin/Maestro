{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },

  "Server": {
    "BindAddress": "0.0.0.0",
    "Port": 5000
  },

  "Security": {
    "ApiKey": {
      "Enabled": false
    }
  },

  "Providers": {
    "Azure": {
      "UseDefaultCredential": true
    }
  }
}

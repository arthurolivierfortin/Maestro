{
  "name": "@b-one/maestro-cli",
  "version": "1.0.0",
  "description": "CLI for Maestro — AI orchestration platform with blocks, sessions, and training",
  "bin": {
    "maestro": "./index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "index.js",
    "*.ts",
    "monitor/",
    "tests/"
  ],
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "ink": "^6.7.0",
    "minimist": "^1.2.8",
    "react": "^19.2.4"
  },
  "scripts": {
    "test": "tsx tests/validator.test.ts && tsx tests/execute-integration.test.ts && tsx tests/phase-workflow-tree.test.ts",
    "test:ink": "vitest run tests/interactive/",
    "test:all": "npm test && npm run test:ink",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ink": "tsc --noEmit -p monitor/ink/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

{
  "id": "cantante-developer",
  "name": "Cantante Developer Agent",
  "blockType": "agent",
  "version": "1.0.0",
  "isAtomic": false,
  "description": "Agent for developing Cantante codebase with file operations and commit generation",
  "inputs": [
    {
      "id": "task",
      "name": "Task",
      "type": "string",
      "required": true,
      "description": "The task to accomplish"
    },
    {
      "id": "workingDir",
      "name": "Working Directory",
      "type": "string",
      "required": true,
      "description": "The working directory"
    },
    {
      "id": "context",
      "name": "Context",
      "type": "string",
      "required": false,
      "description": "Additional context"
    }
  ],
  "outputs": [
    {
      "id": "result",
      "name": "Result",
      "type": "string",
      "description": "Task result"
    },
    {
      "id": "filesModified",
      "name": "Files Modified",
      "type": "array",
      "description": "Modified files"
    },
    {
      "id": "status",
      "name": "Status",
      "type": "string",
      "description": "Task status"
    }
  ],
  "config": {
    "maxIterations": 50,
    "maxTokens": 10000,
    "temperature": 0.7,
    "timeoutMs": 300000,
    "requireApproval": false,
    "model": null,
    "systemPrompt": null,
    "tools": []
  },
  "metadata": {
    "category": "development",
    "tags": [
      "cantante",
      "development",
      "file-ops",
      "git"
    ],
    "author": null
  },
  "capabilities": []
}
{
  "$schema": "../../../../docs/schemas/block.schema.json",
  "id": "foundry:agent-improvement-loop",
  "name": "Agent Improvement Loop",
  "blockType": "workflow",
  "version": "3.0.0",
  "isAtomic": false,
  "description": "Workflow for developing an agent tool through iterative improvement phases (creation, optimization) followed by one-shot validation and publish phases. Uses for-each for iterative phases and phase nodes for one-shot steps.",

  "inputs": [
    {
      "id": "targetFitness",
      "name": "Target Fitness",
      "type": "number",
      "required": false,
      "default": 0.85,
      "description": "Target fitness score to achieve (0.0-1.0)"
    },
    {
      "id": "maxIterations",
      "name": "Max Iterations",
      "type": "number",
      "required": false,
      "default": 50,
      "description": "Maximum number of improvement iterations per phase"
    }
  ],

  "outputs": [
    {
      "id": "success",
      "name": "Success",
      "type": "boolean",
      "description": "Whether target fitness was achieved"
    },
    {
      "id": "finalFitness",
      "name": "Final Fitness",
      "type": "number",
      "description": "Final fitness score after all iterations"
    }
  ],

  "config": {
    "nodes": [
      {
        "id": "improve-phases",
        "type": "for-each",
        "source": "_improvementPhases",
        "itemId": "id",
        "configLookup": true,
        "resetVariables": {
          "currentIteration": 0,
          "currentFitness": 0,
          "scoreHistory": [],
          "_lastValidationFeedback": "",
          "_bestFitness": 0.0,
          "_plateauCount": 0,
          "_shouldStop": false,
          "_tokenCount": 0,
          "_qualityScore": 0.0
        },
        "nodes": [
          {
            "id": "load-artifact",
            "blockRef": "system:block-loader",
            "inputs": {}
          },
          {
            "id": "improvement-loop",
            "type": "while",
            "condition": "{{currentFitness}} < {{targetFitness}} && {{iteration}} < {{maxIterations}}",
            "maxIterations": "{{maxIterations}}",
            "nodes": [
              {
                "id": "run-training",
                "blockRef": "system:artifact-loader",
                "inputs": {}
              },
              {
                "id": "generate-improvements",
                "blockRef": "system:inference",
                "inputs": {}
              },
              {
                "id": "check-quality",
                "blockRef": "system:validator",
                "inputs": {}
              },
              {
                "id": "apply-result",
                "blockRef": "system:file-writer",
                "inputs": {}
              }
            ]
          },
          {
            "id": "finalize-improvement",
            "blockRef": "system:training-finalizer",
            "inputs": {}
          }
        ]
      },
      {
        "id": "validation",
        "type": "phase",
        "configSection": "validation",
        "nodes": [
          {
            "id": "load-for-validation",
            "blockRef": "system:artifact-loader",
            "inputs": {}
          },
          {
            "id": "validate-artifact",
            "blockRef": "system:inference",
            "inputs": {}
          },
          {
            "id": "check-validation",
            "blockRef": "system:validator",
            "inputs": {}
          },
          {
            "id": "write-validated",
            "blockRef": "system:file-writer",
            "inputs": {}
          }
        ]
      },
      {
        "id": "publish",
        "type": "phase",
        "configSection": "publish",
        "nodes": [
          {
            "id": "load-for-publish",
            "blockRef": "system:artifact-loader",
            "inputs": {}
          },
          {
            "id": "enrich-metadata",
            "blockRef": "system:inference",
            "inputs": {}
          },
          {
            "id": "check-publish",
            "blockRef": "system:validator",
            "inputs": {}
          },
          {
            "id": "write-final",
            "blockRef": "system:file-writer",
            "inputs": {}
          }
        ]
      },
      {
        "id": "doc-tree",
        "blockRef": "system:tree-documenter",
        "inputs": {
          "filename": ".maestro/docs/session-tree.md"
        }
      },
      {
        "id": "write-metrics",
        "blockRef": "system:file-writer",
        "inputs": {
          "source": "_phaseMetrics",
          "filename": ".maestro/metrics/training-metrics.json"
        }
      },
      {
        "id": "shell-format-report",
        "blockRef": "system:shell",
        "inputs": {
          "command": "node C:\\Meastro\\tools\\format-metrics-report.js .maestro/metrics/training-metrics.json .maestro/docs"
        }
      }
    ],
    "connections": [
      { "from": "improve-phases", "to": "validation" },
      { "from": "validation", "to": "publish" },
      { "from": "publish", "to": "doc-tree" },
      { "from": "doc-tree", "to": "write-metrics" },
      { "from": "write-metrics", "to": "shell-format-report" }
    ]
  },

  "metadata": {
    "category": "foundry",
    "tags": ["workflow", "foundry", "training", "improvement", "agent"],
    "entryPoint": "improve-agent"
  },

  "capabilities": ["orchestration", "llm", "training", "evaluation"]
}

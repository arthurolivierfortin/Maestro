{
  "$schema": "../../../docs/schemas/block.schema.json",
  "id": "cantante-add-feature",
  "name": "Cantante Add Feature Workflow",
  "blockType": "workflow",
  "version": "1.0.0",
  "isAtomic": false,
  "description": "Explicit workflow for adding features to Cantante. Uses LLM for code generation only, not decision-making.",
  "position": { "x": 0, "y": 0 },
  "inputs": [
    {
      "id": "feature",
      "name": "Feature Description",
      "type": "string",
      "required": true,
      "description": "What feature to add (e.g., 'volume slider')"
    },
    {
      "id": "targetFile",
      "name": "Target File",
      "type": "string",
      "required": true,
      "description": "The file to modify (e.g., 'src/renderer/index.ts')"
    },
    {
      "id": "projectPath",
      "name": "Project Path",
      "type": "string",
      "required": false,
      "default": "C:/Cantante",
      "description": "Path to Cantante"
    }
  ],
  "outputs": [
    {
      "id": "success",
      "name": "Success",
      "type": "boolean",
      "description": "Whether the feature was added"
    },
    {
      "id": "generatedCode",
      "name": "Generated Code",
      "type": "string",
      "description": "The code that was generated"
    }
  ],
  "config": {
    "type": "workflow",
    "description": "Step-by-step workflow for adding features",
    "version": "1.0.0",
    "variables": []
  },
  "children": [],
  "connections": [],
  "metadata": {
    "category": "development",
    "tags": ["cantante", "workflow", "feature", "explicit"],
    "author": "maestro-team",
    "createdAt": "2025-01-29T00:00:00Z",
    "updatedAt": "2025-01-29T00:00:00Z",
    "status": "active"
  },
  "capabilities": ["code-generation", "file-ops"]
}

{
  "$schema": "../docs/schemas/workflow-schema.json",
  "id": "f1e2d3c4-b5a6-4798-9012-3456789fedcb",
  "name": "Full Feature Development Pipeline",
  "description": "Complete end-to-end workflow for developing a feature: planning, coding, testing, review, and PR creation",
  "version": "1.0.0",
  "author": "maestro-team@example.com",
  "createdAt": "2024-01-09T00:00:00Z",
  "updatedAt": "2024-01-09T00:00:00Z",
  "nodes": [
    {
      "id": "trigger-1",
      "type": "TriggerNode",
      "name": "Feature Request",
      "position": { "x": 100, "y": 300 },
      "config": {
        "triggerType": "manual",
        "inputSchema": {
          "featureDescription": {
            "type": "string",
            "description": "High-level feature description"
          },
          "targetBranch": {
            "type": "string",
            "default": "main"
          }
        }
      }
    },
    {
      "id": "planner-1",
      "type": "AgentNode",
      "agentType": "Planner",
      "name": "Create Implementation Plan",
      "position": { "x": 300, "y": 300 },
      "config": {
        "outputFormat": "markdown",
        "includeTestStrategy": true,
        "breakdownLevel": "detailed",
        "tools": ["filesystem"]
      }
    },
    {
      "id": "coder-1",
      "type": "AgentNode",
      "agentType": "Coder",
      "name": "Implement Feature",
      "position": { "x": 500, "y": 300 },
      "config": {
        "language": "csharp",
        "framework": "dotnet",
        "followPlan": true,
        "tools": ["filesystem", "bash", "git"]
      }
    },
    {
      "id": "tester-1",
      "type": "AgentNode",
      "agentType": "Tester",
      "name": "Write Tests",
      "position": { "x": 700, "y": 300 },
      "config": {
        "testFramework": "xunit",
        "coverageTarget": 80,
        "includeIntegrationTests": true,
        "tools": ["filesystem", "bash"]
      }
    },
    {
      "id": "validator-1",
      "type": "ValidatorNode",
      "name": "Run Tests",
      "position": { "x": 900, "y": 300 },
      "config": {
        "validationType": "test-execution",
        "command": "dotnet test",
        "failOnError": true
      }
    },
    {
      "id": "decision-1",
      "type": "DecisionNode",
      "name": "Tests Passed?",
      "position": { "x": 1100, "y": 300 },
      "config": {
        "condition": {
          "type": "boolean",
          "path": "testResults.allPassed"
        }
      }
    },
    {
      "id": "debugger-1",
      "type": "AgentNode",
      "agentType": "Debugger",
      "name": "Fix Test Failures",
      "position": { "x": 1100, "y": 450 },
      "config": {
        "maxAttempts": 3,
        "tools": ["filesystem", "bash"]
      }
    },
    {
      "id": "reviewer-1",
      "type": "AgentNode",
      "agentType": "Reviewer",
      "name": "Code Review",
      "position": { "x": 1300, "y": 300 },
      "config": {
        "checkStyle": true,
        "checkSecurity": true,
        "checkPerformance": true,
        "tools": ["filesystem"]
      }
    },
    {
      "id": "git-pr",
      "type": "ToolNode",
      "toolType": "Git",
      "name": "Create Pull Request",
      "position": { "x": 1500, "y": 300 },
      "config": {
        "command": "create-pr",
        "branchPrefix": "feature/maestro-",
        "assignReviewers": true,
        "includeDescription": true
      }
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "trigger-1",
      "to": "planner-1",
      "fromOutput": "featureDescription",
      "toInput": "task"
    },
    {
      "id": "conn-2",
      "from": "planner-1",
      "to": "coder-1",
      "fromOutput": "plan",
      "toInput": "requirements"
    },
    {
      "id": "conn-3",
      "from": "coder-1",
      "to": "tester-1",
      "fromOutput": "code",
      "toInput": "codeToTest"
    },
    {
      "id": "conn-4",
      "from": "tester-1",
      "to": "validator-1",
      "fromOutput": "tests",
      "toInput": "testsToRun"
    },
    {
      "id": "conn-5",
      "from": "validator-1",
      "to": "decision-1",
      "fromOutput": "results",
      "toInput": "testResults"
    },
    {
      "id": "conn-6",
      "from": "decision-1",
      "to": "reviewer-1",
      "fromOutput": "true",
      "toInput": "code",
      "condition": { "branchType": "success" }
    },
    {
      "id": "conn-7",
      "from": "decision-1",
      "to": "debugger-1",
      "fromOutput": "false",
      "toInput": "failureInfo",
      "condition": { "branchType": "failure" }
    },
    {
      "id": "conn-8",
      "from": "debugger-1",
      "to": "validator-1",
      "fromOutput": "fixes",
      "toInput": "codeChanges"
    },
    {
      "id": "conn-9",
      "from": "reviewer-1",
      "to": "git-pr",
      "fromOutput": "reviewReport",
      "toInput": "prDescription"
    }
  ],
  "metadata": {
    "tags": ["advanced", "full-pipeline", "production"],
    "estimatedDuration": "PT45M",
    "requiredTools": ["git", "dotnet", "bash"]
  }
}

{
  "id": "test-designer",
  "name": "Test Designer",
  "version": "2.0.0",
  "description": "Workflow that generates test suites from contract definitions.",
  "requiredCapabilities": ["structured-output"],
  "minimumFitness": 0.3,
  "features": {
    "test-generation": {
      "description": "Generate valid test suites from contracts",
      "requires": ["structured-output"],
      "weight": 0.6,
      "minimumScore": 0.7,
      "tests": [
        {
          "id": "generates-tests-for-greeting",
          "description": "Produces a test suite for a greeting contract",
          "prompt": "greeting",
          "check": { "type": "contains-all", "values": ["contractId", "features", "tests"] }
        },
        {
          "id": "generates-tests-for-code-reviewer",
          "description": "Produces a test suite for a code reviewer contract",
          "prompt": "code-reviewer",
          "check": { "type": "contains-all", "values": ["contractId", "features", "tests"] }
        }
      ]
    },
    "test-quality": {
      "description": "Generated tests have proper structure and variety",
      "requires": ["structured-output"],
      "weight": 0.4,
      "minimumScore": 0.6,
      "tests": [
        {
          "id": "tests-cover-features",
          "description": "Test suite covers all features in the contract",
          "prompt": "maestro-assistant",
          "check": { "type": "contains-all", "values": ["conversation", "maestro-operations"] }
        },
        {
          "id": "tests-use-varied-checks",
          "description": "Test suite uses multiple check types",
          "prompt": "agent-creator",
          "check": { "type": "contains-any", "values": ["contains", "tool-call", "json-parseable", "regex", "does-not-contain"] }
        }
      ]
    }
  },
  "scoring": { "method": "weighted-average" }
}

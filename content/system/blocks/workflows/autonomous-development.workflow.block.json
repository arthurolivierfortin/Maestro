{
  "$schema": "../../../docs/schemas/block.schema.json",
  "id": "autonomous-development",
  "name": "Autonomous Development Workflow",
  "blockType": "workflow",
  "version": "3.2.0",
  "isAtomic": false,
  "description": "Complete autonomous development workflow v3.2: analyze → plan-retry-loop (while: plan + validate + conditional gate) → for-each step (implement + verify) → test → review → conditional commit. Plan validation uses while loop + json-validator — no executor-level output validation.",

  "inputs": [
    {
      "id": "task",
      "name": "Development Task",
      "type": "string",
      "required": true,
      "description": "The development task to accomplish"
    },
    {
      "id": "repoPath",
      "name": "Repository Path",
      "type": "string",
      "required": true,
      "description": "Absolute path to the target repository"
    }
  ],

  "outputs": [
    { "id": "summary", "type": "string", "description": "Workflow execution summary" }
  ],

  "config": {
    "nodes": [
      {
        "id": "prepare",
        "name": "Analyze Project",
        "blockRef": "project-preparer",
        "inputs": {
          "repoPath": "{{inputs.repoPath}}",
          "task": "Analyze the project repository at the path provided in repoPath. List its root directory, read package.json or equivalent config file, then store your findings in memory and call step-complete with structured JSON context."
        },
        "description": "Analyze the project structure, stack, and conventions"
      },
      {
        "id": "cache-context",
        "name": "Cache Project Context",
        "blockRef": "memory",
        "inputs": {
          "operation": "add-entry",
          "storeId": "project-context",
          "key": "repo-structure",
          "content": "{{_nodeResult_prepare}}",
          "confidence": "0.9",
          "tags": "project,context"
        },
        "description": "Store project analysis in memory for future runs"
      },
      {
        "id": "plan-retry-loop",
        "name": "Plan with Retry",
        "type": "while",
        "condition": "{{_planFormatValid}} != true",
        "maxIterations": 3,
        "nodes": [
          {
            "id": "plan",
            "name": "Plan Implementation",
            "blockRef": "task-planner",
            "inputs": {
              "repoPath": "{{inputs.repoPath}}",
              "task": "{{inputs.task}}",
              "context": "{{_nodeResult_prepare}}",
              "validationError": "{{_planValidationError}}"
            },
            "description": "Decompose the task into ordered implementation steps"
          },
          {
            "id": "validate-plan",
            "name": "Validate Plan",
            "blockRef": "json-validator",
            "inputs": {
              "data": "{{_nodeResult_plan.summary}}",
              "schema": "{\"type\":\"array\",\"minItems\":1,\"items\":{\"requiredFields\":[\"id\",\"action\",\"target\",\"description\"],\"fieldTypes\":{\"id\":\"number\",\"action\":\"string\",\"target\":\"string\",\"description\":\"string\"},\"allowedValues\":{\"action\":[\"create\",\"modify\",\"delete\",\"add-dependency\",\"run-command\"]}}}"
            },
            "description": "Validate the plan JSON: array of steps with id, action, target, description"
          },
          {
            "id": "plan-format-gate",
            "name": "Plan Format Gate",
            "type": "conditional",
            "condition": "{{_nodeResult_validate-plan.isValid}} == false",
            "then": {
              "nodes": [
                {
                  "id": "store-validation-error",
                  "type": "set-variable",
                  "variable": "_planValidationError",
                  "value": "Your plan output failed JSON validation. Errors: {{_nodeResult_validate-plan.errors}}. Your step-complete summary MUST be a raw JSON array of step objects starting with '[' and ending with ']'. No prose, no wrapper objects.",
                  "description": "Store validation error for next planner iteration"
                }
              ]
            },
            "else": {
              "nodes": [
                {
                  "id": "mark-plan-valid",
                  "type": "set-variable",
                  "variable": "_planFormatValid",
                  "value": "true",
                  "description": "Mark plan as valid to exit while loop"
                }
              ]
            },
            "description": "If validation failed, store error for retry; if passed, mark valid to exit loop"
          }
        ],
        "description": "Retry planning up to 3 times until json-validator passes"
      },
      {
        "id": "store-plan",
        "type": "set-variable",
        "variable": "_planSteps",
        "value": "{{_nodeResult_plan}}",
        "description": "Store the plan output for for-each iteration (uses plan node result, not validator output)"
      },
      {
        "id": "implement-steps",
        "name": "Implement Steps",
        "type": "for-each",
        "source": "_planSteps",
        "itemId": "id",
        "configLookup": false,
        "nodes": [
          {
            "id": "implement-step",
            "name": "Implement Step",
            "blockRef": "implement-single-step",
            "inputs": {
              "step": "{{_currentItemJson}}",
              "workingDir": "{{inputs.repoPath}}",
              "context": "{{_nodeResult_prepare}}"
            },
            "description": "Implement a single step from the plan"
          },
          {
            "id": "validate-step",
            "name": "Verify Step",
            "blockRef": "step-validator",
            "inputs": {
              "step": "{{_currentItemJson}}",
              "result": "{{previousOutput}}",
              "workingDir": "{{inputs.repoPath}}"
            },
            "description": "Verify the step was actually implemented on disk"
          }
        ],
        "description": "Iterate over each plan step: implement then verify on disk"
      },
      {
        "id": "test",
        "name": "Run Tests",
        "blockRef": "test-executor",
        "inputs": {
          "repoPath": "{{inputs.repoPath}}",
          "task": "{{inputs.task}}"
        },
        "description": "Detect and run the project test suite"
      },
      {
        "id": "review",
        "name": "Review Code Quality",
        "blockRef": "code-reviewer",
        "inputs": {
          "changes": "Task: {{inputs.task}}\n\nPlan steps executed: {{_planSteps}}\n\nTest results:\n{{_nodeResult_test}}",
          "testResults": "{{_nodeResult_test}}",
          "conventions": "{{_nodeResult_prepare}}",
          "task": "{{inputs.task}}"
        },
        "description": "Score the implementation quality"
      },
      {
        "id": "review-gate",
        "name": "Review Gate",
        "type": "conditional",
        "condition": "{{_nodeResult_review.approved}} == true",
        "then": {
          "id": "commit",
          "name": "Commit Changes",
          "blockRef": "git-committer",
          "inputs": {
            "repoPath": "{{inputs.repoPath}}",
            "task": "{{inputs.task}}",
            "changes": "{{_nodeResult_review}}",
            "review": "{{_nodeResult_review}}"
          }
        },
        "description": "Only commit if review approved (score >= 0.8)"
      }
    ],

    "connections": []
  },

  "metadata": {
    "category": "development",
    "tags": ["workflow", "autonomous", "development", "full-pipeline", "v3"],
    "author": "maestro-team",
    "tier": 1
  }
}

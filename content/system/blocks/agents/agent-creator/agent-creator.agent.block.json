{
  "id": "agent-creator",
  "name": "Agent Creator",
  "blockType": "agent",
  "version": "1.0.0",
  "isAtomic": false,
  "description": "Meta-agent that creates other agents. Takes a natural language description, designs the architecture, generates sub-blocks, trains them via foundry pipeline, assembles the final agent, and publishes it. Uses the same composite pattern as autonomous-dev: state manager + deterministic workflow + interaction agent.",
  "inputs": [
    { "id": "request", "type": "string", "required": true, "description": "Natural language description of the agent to create" },
    { "id": "fitnessThreshold", "type": "number", "required": false, "description": "Minimum fitness for sub-blocks (default: 0.80)" }
  ],
  "outputs": [
    { "id": "agentId", "type": "string", "description": "ID of the created agent" },
    { "id": "published", "type": "boolean", "description": "Whether the agent was published" },
    { "id": "summary", "type": "object", "description": "Full creation summary: blocks, fitness scores, training iterations" }
  ],
  "config": {
    "model": "claude-sonnet",
    "stateManager": "workflow-state-manager",
    "interactionAgent": "interaction-handler",
    "maxIterations": 50,
    "wallClockTimeoutSeconds": 3600,
    "nodes": [
      {
        "id": "understand",
        "blockRef": "understand-request",
        "inputs": { "request": "{{request}}" }
      },
      {
        "id": "design",
        "blockRef": "design-architecture",
        "inputs": { "requirements": "{{understand.output}}" }
      },
      {
        "id": "create-workspace",
        "type": "shell",
        "command": "node index.js workspace create --name \"agent-creation-{{understand.output.type}}\" --json",
        "inputs": {}
      },
      {
        "id": "generate-and-train",
        "type": "for-each",
        "source": "design.output.creationOrder",
        "nodes": [
          {
            "id": "generate-block",
            "blockRef": "block-generator",
            "inputs": {
              "design": "{{design.output}}",
              "blockSpec": "{{currentItem}}"
            }
          },
          {
            "id": "train-block",
            "blockRef": "training-orchestrator",
            "inputs": {
              "blockJson": "{{generate-block.output.blockJson}}",
              "systemPrompt": "{{generate-block.output.systemPrompt}}",
              "workspaceId": "{{create-workspace.output}}",
              "fitnessThreshold": "{{fitnessThreshold}}"
            }
          }
        ]
      },
      {
        "id": "assemble",
        "blockRef": "agent-assembler",
        "inputs": {
          "design": "{{design.output}}",
          "publishedBlocks": "{{generate-and-train.output}}",
          "workspaceId": "{{create-workspace.output}}"
        }
      },
      {
        "id": "show-summary",
        "type": "widget",
        "widget": {
          "type": "table",
          "title": "Agent Creation Summary",
          "columns": ["Block", "Fitness", "Status"],
          "source": "generate-and-train.output"
        }
      }
    ]
  },
  "metadata": {
    "category": "system",
    "designation": "creator",
    "tags": ["meta-agent", "agent-creation", "foundry", "orchestrator"]
  }
}

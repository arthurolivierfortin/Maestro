{
  "id": "contract-definer",
  "name": "Contract Definer",
  "blockType": "agent",
  "version": "1.0.0",
  "isAtomic": true,
  "description": "Conversational agent that understands user intent and produces formal Maestro contract definitions. Asks clarifying questions, recommends capabilities, defines features with weights, and generates complete contract JSON.",
  "contract": "contract-definer",
  "capabilities": ["conversation", "structured-output", "tool-calling"],
  "inputs": [
    { "id": "description", "type": "string", "required": true, "description": "What the user wants to build" },
    { "id": "existingContractId", "type": "string", "required": false, "description": "ID of existing contract to analyze/improve" },
    { "id": "outputDir", "type": "string", "required": false, "description": "Where to write generated contract files" }
  ],
  "outputs": [
    { "id": "contractJson", "type": "string", "description": "The generated contract JSON" },
    { "id": "contractId", "type": "string", "description": "ID of the generated contract" },
    { "id": "contractPath", "type": "string", "description": "Path to written contract file" }
  ],
  "config": {
    "model": "claude-opus-4-6",
    "maxIterations": 15,
    "wallClockTimeoutSeconds": 480,
    "systemPromptFile": "system-prompt.md",
    "context": {
      "strategy": "sliding-window",
      "maxTokens": 16384,
      "keepSystemPrompt": true,
      "keepLastN": 12
    },
    "nodes": [
      {
        "id": "init",
        "type": "set-variable",
        "variable": "_agentDone",
        "value": "false"
      },
      {
        "id": "agent-while",
        "type": "while",
        "condition": "{{_agentDone}} != true",
        "maxIterations": "{{maxIterations}}",
        "nodes": [
          {
            "id": "read-conversation",
            "blockRef": "conversation-read",
            "inputs": { "conversationId": "{{_conversationId}}", "keepLastN": "12" }
          },
          {
            "id": "llm-call",
            "blockRef": "inference",
            "config": {
              "model": "claude-opus-4-6",
              "maxTokens": 8192,
              "temperature": 0.3
            },
            "inputs": { "messages": "{{_nodeResult_read-conversation.messages}}" }
          },
          {
            "id": "append-assistant",
            "blockRef": "conversation-append",
            "inputs": {
              "conversationId": "{{_conversationId}}",
              "role": "assistant",
              "content": "{{_nodeResult_llm-call.content}}"
            }
          },
          {
            "id": "parse-response",
            "blockRef": "response-parser",
            "inputs": { "rawResponse": "{{_nodeResult_llm-call.content}}" }
          },
          {
            "id": "route-response",
            "type": "conditional",
            "condition": "{{_nodeResult_parse-response.type}}",
            "branches": {
              "tool-call": {
                "nodes": [
                  {
                    "id": "dispatch-tool",
                    "blockRef": "tool-dispatcher",
                    "inputs": {
                      "toolId": "{{_nodeResult_parse-response.toolId}}",
                      "args": "{{_nodeResult_parse-response.args}}"
                    }
                  },
                  {
                    "id": "append-tool-result",
                    "blockRef": "conversation-append",
                    "inputs": {
                      "conversationId": "{{_conversationId}}",
                      "role": "user",
                      "content": "[Tool result for {{_nodeResult_parse-response.toolId}}]:\n{{_nodeResult_dispatch-tool.result}}"
                    }
                  }
                ]
              },
              "step-complete": {
                "nodes": [
                  {
                    "id": "validate-summary",
                    "blockRef": "summary-validator",
                    "inputs": { "summary": "{{_nodeResult_parse-response.summary}}" }
                  },
                  {
                    "id": "route-validation",
                    "type": "conditional",
                    "condition": "{{_nodeResult_validate-summary.valid}}",
                    "branches": {
                      "true": {
                        "nodes": [
                          { "id": "set-done", "type": "set-variable", "variable": "_agentDone", "value": "true" },
                          { "id": "set-result", "type": "set-variable", "variable": "_agentResult", "value": "{{_nodeResult_parse-response.summary}}" }
                        ]
                      },
                      "false": {
                        "nodes": [
                          {
                            "id": "nudge-text-response",
                            "blockRef": "conversation-append",
                            "inputs": {
                              "conversationId": "{{_conversationId}}",
                              "role": "user",
                              "content": "{{_nodeResult_validate-summary.reason}}"
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              "text": {
                "nodes": [
                  {
                    "id": "validate-text",
                    "blockRef": "summary-validator",
                    "inputs": { "summary": "{{_nodeResult_parse-response.text}}" }
                  },
                  {
                    "id": "route-text-validation",
                    "type": "conditional",
                    "condition": "{{_nodeResult_validate-text.valid}}",
                    "branches": {
                      "true": {
                        "nodes": [
                          { "id": "set-text-result", "type": "set-variable", "variable": "_agentResult", "value": "{{_nodeResult_parse-response.text}}" },
                          { "id": "set-text-done", "type": "set-variable", "variable": "_agentDone", "value": "true" }
                        ]
                      },
                      "false": {
                        "nodes": [
                          {
                            "id": "nudge-text-plain",
                            "blockRef": "conversation-append",
                            "inputs": {
                              "conversationId": "{{_conversationId}}",
                              "role": "user",
                              "content": "{{_nodeResult_validate-text.reason}}"
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              "retry": {
                "nodes": [
                  {
                    "id": "nudge-agent",
                    "blockRef": "conversation-append",
                    "inputs": {
                      "conversationId": "{{_conversationId}}",
                      "role": "user",
                      "content": "Your last response was empty or malformed. You can respond with plain text, a THINK/ACTION tool call, or call step-complete if you're done."
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "metadata": {
    "category": "creation",
    "designation": "agent",
    "tags": ["contracts", "testing", "creation", "block-forge", "conversational"],
    "tier": 1
  }
}

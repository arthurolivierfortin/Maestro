{
  "id": "dev-orchestrator",
  "name": "Development Orchestrator",
  "blockType": "agent",
  "version": "1.0.0",
  "isAtomic": false,
  "description": "Intelligent orchestrator for development tasks. Decides approach based on task complexity: simple tasks are done directly, complex tasks are planned first. Has access to file I/O, shell, validation, and delegation tools.",
  "inputs": [
    { "id": "task", "type": "string", "required": true, "description": "Description of what to implement" },
    { "id": "workingDir", "type": "string", "required": true, "description": "Absolute path to the repository root" },
    { "id": "context", "type": "string", "required": false, "description": "Project context (stack, conventions, structure)" }
  ],
  "outputs": [
    { "id": "result", "type": "string", "description": "JSON summary of what was accomplished" }
  ],
  "config": {
    "maxIterations": 30,
    "wallClockTimeoutSeconds": 900,
    "systemPromptFile": "system-prompt.md",
    "context": {
      "strategy": "sliding-window",
      "maxTokens": 8192,
      "keepSystemPrompt": true,
      "keepLastN": 25
    },
    "planningModel": "claude-opus-4-6",
    "planningIterations": 2,
    "nodes": [
      {
        "id": "init",
        "type": "set-variable",
        "variable": "_agentDone",
        "value": "false"
      },
      {
        "id": "init-iteration",
        "type": "set-variable",
        "variable": "_currentIteration",
        "value": "0"
      },
      {
        "id": "agent-while",
        "type": "while",
        "condition": "{{_agentDone}} != true",
        "maxIterations": "{{maxIterations}}",
        "nodes": [
          {
            "id": "read-conversation",
            "blockRef": "conversation-read",
            "inputs": { "conversationId": "{{_conversationId}}" }
          },
          {
            "id": "select-model",
            "type": "conditional",
            "condition": "{{_currentIteration}} < {{planningIterations}}",
            "branches": {
              "true": {
                "nodes": [
                  {
                    "id": "llm-call-planning",
                    "blockRef": "inference",
                    "config": { "model": "{{planningModel}}" },
                    "inputs": { "messages": "{{_nodeResult_read-conversation.messages}}" }
                  },
                  {
                    "id": "set-llm-result-planning",
                    "type": "set-variable",
                    "variable": "_llmContent",
                    "value": "{{_nodeResult_llm-call-planning.content}}"
                  }
                ]
              },
              "false": {
                "nodes": [
                  {
                    "id": "llm-call-regular",
                    "blockRef": "inference",
                    "config": {
                      "model": "claude-sonnet-4-6",
                      "maxTokens": 4096,
                      "temperature": 0
                    },
                    "inputs": { "messages": "{{_nodeResult_read-conversation.messages}}" }
                  },
                  {
                    "id": "set-llm-result-regular",
                    "type": "set-variable",
                    "variable": "_llmContent",
                    "value": "{{_nodeResult_llm-call-regular.content}}"
                  }
                ]
              }
            }
          },
          {
            "id": "increment-iteration",
            "type": "set-variable",
            "variable": "_currentIteration",
            "value": "{{_currentIteration + 1}}"
          },
          {
            "id": "append-assistant",
            "blockRef": "conversation-append",
            "inputs": {
              "conversationId": "{{_conversationId}}",
              "role": "assistant",
              "content": "{{_llmContent}}"
            }
          },
          {
            "id": "parse-response",
            "blockRef": "response-parser",
            "inputs": { "rawResponse": "{{_llmContent}}" }
          },
          {
            "id": "route-response",
            "type": "conditional",
            "condition": "{{_nodeResult_parse-response.type}}",
            "branches": {
              "tool-call": {
                "nodes": [
                  {
                    "id": "dispatch-tool",
                    "blockRef": "tool-dispatcher",
                    "inputs": {
                      "toolId": "{{_nodeResult_parse-response.toolId}}",
                      "args": "{{_nodeResult_parse-response.args}}"
                    }
                  },
                  {
                    "id": "append-tool-result",
                    "blockRef": "conversation-append",
                    "inputs": {
                      "conversationId": "{{_conversationId}}",
                      "role": "user",
                      "content": "[Tool result for {{_nodeResult_parse-response.toolId}}]:\n{{_nodeResult_dispatch-tool.result}}"
                    }
                  }
                ]
              },
              "step-complete": {
                "nodes": [
                  { "id": "set-done", "type": "set-variable", "variable": "_agentDone", "value": "true" },
                  { "id": "set-result", "type": "set-variable", "variable": "_agentResult", "value": "{{_nodeResult_parse-response.summary}}" }
                ]
              },
              "text": {
                "nodes": [
                  { "id": "set-text-result", "type": "set-variable", "variable": "_agentResult", "value": "{{_nodeResult_parse-response.text}}" },
                  { "id": "set-text-done", "type": "set-variable", "variable": "_agentDone", "value": "true" }
                ]
              },
              "retry": {
                "nodes": [
                  {
                    "id": "nudge-agent",
                    "blockRef": "conversation-append",
                    "inputs": {
                      "conversationId": "{{_conversationId}}",
                      "role": "user",
                      "content": "Your last response was empty or malformed. Respond with a JSON tool call. If done, call step-complete."
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "metadata": {
    "category": "development",
    "designation": "orchestrator",
    "tags": ["orchestration", "development", "adaptive", "autonomous"],
    "tier": 1
  }
}

{
  "id": "jarvis",
  "name": "Jarvis Intent Router",
  "blockType": "agent",
  "version": "1.0.0",
  "isAtomic": false,
  "description": "Generic intent router agent. Classifies user messages by intent and routes to appropriate tools or sub-agents. Domain-agnostic — works for any project type.",
  "inputs": [
    { "id": "message", "type": "string", "required": true, "description": "User message to classify and route" },
    { "id": "context", "type": "string", "required": false, "description": "Project context (stack, conventions, recent activity)" },
    { "id": "availableBlocks", "type": "string", "required": false, "description": "JSON list of available block IDs the agent can delegate to" }
  ],
  "outputs": [
    { "id": "result", "type": "string", "description": "JSON summary of what was accomplished" }
  ],
  "config": {
    "maxIterations": 20,
    "wallClockTimeoutSeconds": 600,
    "systemPromptFile": "system-prompt.md",
    "context": {
      "strategy": "sliding-window",
      "maxTokens": 32768,
      "keepSystemPrompt": true,
      "keepLastN": 20
    },
    "nodes": [
      {
        "id": "init",
        "type": "set-variable",
        "variable": "_agentDone",
        "value": "false"
      },
      {
        "id": "agent-while",
        "type": "while",
        "condition": "{{_agentDone}} != true",
        "maxIterations": "{{maxIterations}}",
        "nodes": [
          {
            "id": "read-conversation",
            "blockRef": "conversation-read",
            "inputs": { "conversationId": "{{_conversationId}}" }
          },
          {
            "id": "llm-call",
            "blockRef": "inference",
            "config": {
              "model": "claude-opus-4-6",
              "maxTokens": 4096,
              "temperature": 0
            },
            "inputs": { "messages": "{{_nodeResult_read-conversation.messages}}" }
          },
          {
            "id": "append-assistant",
            "blockRef": "conversation-append",
            "inputs": {
              "conversationId": "{{_conversationId}}",
              "role": "assistant",
              "content": "{{_nodeResult_llm-call.content}}"
            }
          },
          {
            "id": "parse-response",
            "blockRef": "response-parser",
            "inputs": { "rawResponse": "{{_nodeResult_llm-call.content}}" }
          },
          {
            "id": "route-response",
            "type": "conditional",
            "condition": "{{_nodeResult_parse-response.type}}",
            "branches": {
              "step-complete": {
                "nodes": [
                  { "id": "set-done", "type": "set-variable", "variable": "_agentDone", "value": "true" },
                  { "id": "set-result", "type": "set-variable", "variable": "_agentResult", "value": "{{_nodeResult_parse-response.summary}}" }
                ]
              },
              "text": {
                "nodes": [
                  { "id": "set-text-result", "type": "set-variable", "variable": "_agentResult", "value": "{{_nodeResult_parse-response.text}}" },
                  { "id": "set-text-done", "type": "set-variable", "variable": "_agentDone", "value": "true" }
                ]
              },
              "retry": {
                "nodes": [
                  {
                    "id": "nudge-agent",
                    "blockRef": "conversation-append",
                    "inputs": {
                      "conversationId": "{{_conversationId}}",
                      "role": "user",
                      "content": "Your last response was empty or malformed. Please provide your response as text. If done, call step-complete."
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "metadata": {
    "category": "general",
    "designation": "orchestrator",
    "tags": ["intent-routing", "general-purpose", "orchestrator", "assistant"],
    "tier": 1
  }
}

{
  "$schema": "../../../docs/schemas/block.schema.json",
  "id": "cantante-smollm",
  "name": "Cantante SmolLM Agent",
  "blockType": "agent",
  "version": "1.0.0",
  "isAtomic": false,
  "description": "Cantante developer agent optimized for SmolLM2. Uses structured JSON for tool calling.",
  "position": { "x": 0, "y": 0 },
  "inputs": [
    {
      "id": "task",
      "name": "Task",
      "type": "string",
      "required": true,
      "description": "Development task to accomplish"
    },
    {
      "id": "projectPath",
      "name": "Project Path",
      "type": "string",
      "required": false,
      "default": "C:/Cantante",
      "description": "Path to Cantante project"
    }
  ],
  "outputs": [
    {
      "id": "result",
      "name": "Result",
      "type": "string",
      "description": "Task result"
    },
    {
      "id": "filesModified",
      "name": "Files Modified",
      "type": "array",
      "description": "List of modified files"
    }
  ],
  "config": {
    "type": "agent",
    "model": "HuggingFaceTB/SmolLM2-1.7B-Instruct",
    "maxSteps": 5,
    "maxTokens": 200,
    "temperature": 0.0,
    "timeoutMs": 120000,
    "requireApproval": false,
    "tools": [
      "file-read",
      "file-write",
      "directory-list"
    ],
    "systemPrompt": "You output ONLY valid JSON. One action per response.\n\nActions:\n1. List files: {\"tool\":\"list_files\",\"args\":{\"path\":\"C:\\\\path\"}}\n2. Read file: {\"tool\":\"read_file\",\"args\":{\"path\":\"C:\\\\file.txt\"}}\n3. Write file: {\"tool\":\"write_file\",\"args\":{\"path\":\"C:\\\\file.txt\",\"content\":\"...\"}}\n4. FINISH (REQUIRED): {\"tool\":\"done\",\"args\":{\"summary\":\"what was accomplished\"}}\n\nIMPORTANT: After receiving tool results, you MUST call done to finish. Never call the same tool twice with the same arguments."
  },
  "children": [],
  "connections": [],
  "metadata": {
    "category": "development",
    "tags": ["cantante", "smollm", "tool-calling", "structured"],
    "author": "maestro-team",
    "createdAt": "2025-01-29T00:00:00Z",
    "status": "active"
  },
  "capabilities": ["tool-calling", "structured-output"]
}

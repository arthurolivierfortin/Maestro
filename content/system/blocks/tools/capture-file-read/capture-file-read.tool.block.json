  "outputs": [
    {
      "id": "content",
      "type": "string",
      "description": "File content (from capture or disk)"
    }
  ],
  "config": {
    "toolType": "capture-file-read"
  },
  "metadata": {
    "category": "testing",
    "tags": ["capture", "mock", "file-read", "contract-test"]
  },
  "capabilities": ["capture", "testing"]
}
